# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า:  cp .env.example .env
#
# โหมด demo (ดูแดชบอร์ดอย่างเดียว ไม่ต้องมีกลุ่มไลน์):
#   ปล่อย LINE/OpenRouter ว่างไว้ก็ได้ แค่ตั้ง ADMIN_KEY ด้านล่าง
#   แล้วรัน:  npm run demo   →  เปิด http://localhost:3000/admin?key=demo-key-please-change

# --- LINE Messaging API (สร้าง channel ที่ developers.line.biz) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- AI ผ่าน OpenRouter (openrouter.ai/keys) — ใช้สรุป/ตอบคำถาม ---
OPENROUTER_API_KEY=
# โมเดลสรุป/ตอบ (ดีฟอลต์ถูก+เร็ว)
# AI_MODEL=google/gemini-2.5-flash
# โมเดลอ่านรูป/เสียง/วิดีโอ
# VISION_MODEL=google/gemini-2.5-flash

# --- แดชบอร์ด /admin ---
ADMIN_KEY=demo-key-please-change

# --- สำเนาสรุปเข้า Telegram (ไม่ตั้ง = ไม่ส่ง, ทางเลือก) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- อื่นๆ ---
# PORT=3000
# DB_PATH=./groupbot.db          # บน Railway ใช้ volume เช่น /data/groupbot.db
TZ=Asia/Bangkok                  # สำคัญ! บอทคิดเวลาแบบไทย — cloud ส่วนใหญ่เป็น UTC ถ้าไม่ตั้งสรุปจะเพี้ยนเวลา
