name: CI

# รันเทสทุกครั้งที่ push หรือเปิด PR — ไม่ต้องใช้ secret ใดๆ (เทสเป็น offline ล้วน)
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        node: [20, 22]
    steps:
      - uses: actions/checkout@v4
      - name: ใช้ Node.js ${{ matrix.node }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}
          cache: npm
      - name: ติดตั้ง dependencies
        run: npm ci
      - name: รันเทส
        run: npm test
      - name: เช็คว่า seed + แดชบอร์ดทำงาน (smoke test)
        run: |
          node scripts/seed-mock.js
          node -e "const {renderDashboard}=require('./src/dashboard');const h=renderDashboard('test-key');if(!h.includes('แดชบอร์ด'))process.exit(1);console.log('แดชบอร์ด render ได้')"
        env:
          ADMIN_KEY: test-key
